# FastAPI + Neon. Use the pooled host (-pooler) for normal API traffic.
DATABASE_URL=postgresql://user:password@your-endpoint-pooler.region.aws.neon.tech/selo_vivo?sslmode=require
# Alembic migrations must use the direct, non-pooled endpoint.
DATABASE_URL_UNPOOLED=postgresql://user:password@your-endpoint.region.aws.neon.tech/selo_vivo?sslmode=require

# Gemini stays server-side. The browser never receives this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

APP_ENV=development
# Production: use the exact Netlify site and custom-domain origins, comma-separated.
CORS_ORIGINS=http://localhost:5173
# Render automatically adds its own RENDER_EXTERNAL_HOSTNAME at runtime.
# Add only custom API domains here in production.
ALLOWED_HOSTS=localhost,127.0.0.1,test
LOG_LEVEL=INFO

# Frontend. Set these as Netlify build environment variables in production.
VITE_API_URL=http://localhost:8000
# The connected 1AM wallet deploys its own contract on the selected network.
