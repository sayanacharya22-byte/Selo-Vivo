# FastAPI + Neon. Use the pooled host (-pooler) for normal API traffic.
DATABASE_URL=postgresql://user:password@your-endpoint-pooler.region.aws.neon.tech/selo_vivo?sslmode=require
# Alembic migrations must use the direct, non-pooled endpoint.
DATABASE_URL_UNPOOLED=postgresql://user:password@your-endpoint.region.aws.neon.tech/selo_vivo?sslmode=require

# Gemini stays server-side. The browser never receives this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

APP_ENV=development
CORS_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,test
LOG_LEVEL=INFO

# Frontend
VITE_API_URL=http://localhost:8000
VITE_MIDNIGHT_NETWORK=preview
VITE_PREVIEW_CONTRACT_ADDRESS=
VITE_PREPROD_CONTRACT_ADDRESS=
# Development only. Production clients must attach to a reviewed deployment.
VITE_ALLOW_BROWSER_DEPLOY=false
